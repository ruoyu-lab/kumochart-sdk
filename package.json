{
  "name": "kumochart-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/vue",
    "packages/react",
    "examples",
    "site"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm run dev -w examples",
    "build": "npm run build -w @kumochart-sdk/core && npm run build -w @kumochart-sdk/vue && npm run build -w @kumochart-sdk/react",
    "build:examples": "npm run build -w examples",
    "dev:docs": "npm run dev -w site",
    "build:docs": "npm run build -w site",
    "typecheck": "tsc -p packages/core && tsc -p packages/vue && tsc -p packages/react && vue-tsc -p examples && tsc -p . && tsc -p site",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:docs": "playwright test -c site/playwright.config.ts",
    "bench": "playwright test -c bench/playwright.config.ts",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:docs": "node site/scripts/run.mjs site/scripts/check-code.ts",
    "docs:translations": "node site/scripts/run.mjs site/scripts/translations.ts",
    "release:version": "node scripts/release.mjs version",
    "verify": "npm run check:architecture && npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run check:size && npm run check:docs && npm run build:docs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.13"
  }
}
