{
  "name": "kumo-charts",
  "version": "1.0.0-beta.4",
  "description": "Framework-agnostic, high-performance Canvas trading chart library: a small core, and indicators, drawing tools, chart types, alerts, orders, markers, replay, volume profiles and a watermark as modules.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@kumo-charts/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./indicators": {
      "@kumo-charts/source": "./src/indicators/index.ts",
      "types": "./dist/indicators.d.ts",
      "default": "./dist/indicators.js"
    },
    "./drawings": {
      "@kumo-charts/source": "./src/drawings/index.ts",
      "types": "./dist/drawings.d.ts",
      "default": "./dist/drawings.js"
    },
    "./chart-types": {
      "@kumo-charts/source": "./src/chart-types/index.ts",
      "types": "./dist/chart-types.d.ts",
      "default": "./dist/chart-types.js"
    },
    "./alerts": {
      "@kumo-charts/source": "./src/alerts/index.ts",
      "types": "./dist/alerts.d.ts",
      "default": "./dist/alerts.js"
    },
    "./alert-engine": {
      "@kumo-charts/source": "./src/alert-engine/index.ts",
      "types": "./dist/alert-engine.d.ts",
      "default": "./dist/alert-engine.js"
    },
    "./trading": {
      "@kumo-charts/source": "./src/trading/index.ts",
      "types": "./dist/trading.d.ts",
      "default": "./dist/trading.js"
    },
    "./replay": {
      "@kumo-charts/source": "./src/replay/index.ts",
      "types": "./dist/replay.d.ts",
      "default": "./dist/replay.js"
    },
    "./volume-profile": {
      "@kumo-charts/source": "./src/volume-profile/index.ts",
      "types": "./dist/volume-profile.d.ts",
      "default": "./dist/volume-profile.js"
    },
    "./watermark": {
      "@kumo-charts/source": "./src/watermark/index.ts",
      "types": "./dist/watermark.d.ts",
      "default": "./dist/watermark.js"
    },
    "./all": {
      "@kumo-charts/source": "./src/all.ts",
      "types": "./dist/all.d.ts",
      "default": "./dist/all.js"
    },
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/kumo-charts.iife.js",
  "jsdelivr": "./dist/kumo-charts.iife.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruoyu-lab/kumo-charts.git",
    "directory": "packages/core"
  },
  "homepage": "https://www.kumochart.com/",
  "bugs": {
    "url": "https://github.com/ruoyu-lab/kumo-charts/issues"
  },
  "keywords": [
    "chart",
    "trading",
    "candlestick",
    "kline",
    "canvas",
    "technical-analysis",
    "financial-charts",
    "indicators",
    "volume-profile",
    "charting-library"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
