{
  "name": "@kumo-charts/react",
  "version": "1.0.0-beta.4",
  "description": "Official React adapter for kumo-charts.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
